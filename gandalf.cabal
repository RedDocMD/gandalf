cabal-version:      3.0
name:               gandalf
version:            0.1.0.0
synopsis:           Parse a GDS file and reveal its secrets
-- description:
license:            MIT
license-file:       LICENSE
author:             Deep Majumder
maintainer:         deep.majumder2019@gmail.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Parse,
        AST,
        Structure
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.19.2.0,
        relude ^>= 1.2,
        attoparsec ^>=0.14.4,
        bytestring,
        cereal ^>=0.5.8,
        time
    hs-source-dirs:   src
    default-language: Haskell2010
    mixins:
        base hiding (Prelude),
        relude (Relude as Prelude),
        relude

executable gandalf
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.19.2.0,
        gandalf,
        attoparsec,
        bytestring,
        containers,
        optparse-applicative

    hs-source-dirs:   exe
    default-language: Haskell2010

test-suite gandalf-test
    import:           warnings
    default-language: Haskell2010
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.19.2.0,
        gandalf
